# Required
DISCORD_TOKEN=put_your_bot_token_here
CLIENT_ID=put_your_application_id_here
# Optional: set GUILD_ID for instant testing of slash commands in one server
GUILD_ID=

# Prefix can be changed in Discord with the configured admin prefix command.
DEFAULT_PREFIX=&
OWNER_IDS=

# Database: PostgreSQL is used when DATABASE_URL or PGHOST is configured.
# If not configured, Hyper Core automatically uses its built-in JSON store (no database setup).
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=hypercore
PGUSER=postgres
PGPASSWORD=
PGSSL=false

# Optional safety / behaviour
LOG_LEVEL=info
